{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sammy.app/schemas/corpus-record.schema.json",
  "title": "Sammy corpus record",
  "description": "One knowledge record inside a Sammy corpus export/import package (directive §17/§20).",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "canonical_text",
    "status",
    "sensitivity",
    "created_at",
    "updated_at",
    "review_state",
    "schema_version"
  ],
  "properties": {
    "record_id": { "type": "string", "description": "Stable UUID-formatted record id, preserved verbatim across exports/imports." },
    "vault_id": { "type": "string" },
    "record_type": {
      "type": "string",
      "enum": [
        "fact", "claim", "conclusion", "preference", "person", "relationship",
        "event", "place", "project", "decision", "commitment", "routine",
        "skill", "belief", "quote", "source_summary", "memory_candidate", "correction"
      ]
    },
    "canonical_text": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["candidate", "approved", "rejected", "disputed", "superseded", "archived", "tombstoned"]
    },
    "source_ids": { "type": "array", "items": { "type": "string" } },
    "source_locations": { "type": "array", "items": { "type": "string" } },
    "provenance": {},
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sensitivity": { "type": "string", "enum": ["normal", "sensitive", "local_only"] },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "domain_tags": { "type": "array", "items": { "type": "string" } },
    "routing_tags": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "valid_from": { "type": ["string", "null"] },
    "valid_to": { "type": ["string", "null"] },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "review_state": { "type": "string" },
    "reviewed_by": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"] },
    "contradiction_set": { "type": ["string", "null"] },
    "schema_version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
